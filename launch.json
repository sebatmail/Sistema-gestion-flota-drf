{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Django: Iniciar Servidor (Flota DRF)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/manage.py",
            "args": [
                "runserver",
                "8000"
            ],
            "django": true,
            "autoStartBrowser": true
        },
        {
            "name": "Django: Ejecutar Tests Automatizados",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/manage.py",
            "args": [
                "test"
            ],
            "django": true
        },
        {
            "name": "Python: Cargar Datos de Prueba (Seed)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/seed_data.py",
            "console": "integratedTerminal"
        }
    ]
}
